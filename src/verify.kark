// Integration verification for the Karkain-Repository public API.
import repository

func main() {
    let r = new_repository()
    r = insert(r, 1, "alice")
    r = insert(r, 2, "bob")
    r = update(r, 2, "robert")

    assert_eq(count(r), 2)
    assert_eq(find_required(r, 2), "robert")
    println(describe_record(r, 1))
    println(describe_record(r, 2))
}
